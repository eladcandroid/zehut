# Copy this file to `.env.local` and fill in the values.
# Ask the previous owner (Elad) for the real secret values — they are NOT in git.
# Vars marked (optional) only matter if you use that platform/feature.

# ─── Core ────────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas in prod, local mongod in dev)
MONGODB_URI=mongodb://localhost:27017/zehut
# Public base URL, used for share links + OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin panel + cron ──────────────────────────────────────────────────────
# Basic-auth credentials for /admin
ADMIN_USER=
ADMIN_PASS=
# Shared secret required by scheduled/cron API routes
CRON_SECRET=

# ─── Platform scraper APIs ───────────────────────────────────────────────────
# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Telegram bot token — create via @BotFather
TELEGRAM_BOT_TOKEN=
# Twitter/X API v2 Bearer Token (optional; Basic tier ~$100/mo for read)
TWITTER_BEARER_TOKEN=
# Facebook session cookies for the FB scraper (optional)
FB_C_USER=
FB_XS=
# Chrome DevTools Protocol endpoint for puppeteer-based scraping (optional)
# e.g. a remote browser: ws://host:9222 — leave blank to use local Chrome
CDP_URL=

# ─── Download resolver chain ─────────────────────────────────────────────────
# Tier 1: self-hosted cobalt instance (see infra/cobalt/README.md)
COBALT_URL=https://zehut-cobalt.fly.dev
COBALT_API_KEY=
# Tier 3 fallback: RapidAPI providers (optional)
RAPIDAPI_KEY=
RAPIDAPI_YOUTUBE_HOST=
RAPIDAPI_INSTAGRAM_HOST=
RAPIDAPI_FACEBOOK_HOST=
# Optional YouTube proxy (bypasses IP blocks on serverless)
YT_PROXY_URL=
YT_PROXY_SECRET=

# ─── Cloudflare R2 (download cache bucket) ───────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
