# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the template so new devs know which vars to set (see negation at bottom)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.mcp.json
.env*.local

# Downloaded content images (keep directory but ignore images)
/public/images/content/*
!/public/images/content/.gitkeep

# Auto Claude data directory
.auto-claude/

# Auto Claude generated files
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/

# AI tooling / local assistant state (not part of the project)
.claude/
.frame/
.skillkit/
# Frame auto-generated template files (empty scaffolding, superseded by HANDOFF.md)
/QUICKSTART.md
/STRUCTURE.json
/PROJECT_NOTES.md
/tasks.json

# Scraper temp artifacts (large downloaded player scripts, etc.)
*-player-script.js

# Keep the env template in the repo (overrides the .env* ignores above)
!.env.local.example
